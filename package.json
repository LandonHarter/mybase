{
  "name": "mybase",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "set-version": "bun scripts/set-version.ts",
    "release": "bun scripts/release.ts",
    "dev:api": "bun --cwd apps/api dev",
    "dev:dashboard": "bun --cwd apps/dashboard dev",
    "cli": "bun apps/cli/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json",
    "db:up": "docker compose --project-directory . -f docker/compose.dev.yml up -d",
    "db:down": "docker compose --project-directory . -f docker/compose.dev.yml down",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@mybase/shared": "workspace:*"
  }
}
