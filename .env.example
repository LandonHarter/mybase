API_PORT=4000
DASHBOARD_PORT=4001

MYBASE_API_URL=http://localhost:4000

POSTGRES_USER=mybase
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Storage (Garage). Dev defaults match docker/compose.dev.yml.
GARAGE_ADMIN_URL=http://localhost:3903
GARAGE_ADMIN_TOKEN=change-me
GARAGE_S3_URL=http://localhost:3900
# Shown to apps: S3 endpoint and the base URL for public files.
MYBASE_S3_PUBLIC_URL=http://localhost:3900
MYBASE_PUBLIC_URL=http://localhost:4000
# Cache (Valkey). Dev defaults match docker/compose.dev.yml.
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=change-me
# Where apps reach the cache over TCP (shown in redis:// URLs).
# MYBASE_CACHE_PUBLIC_HOST=localhost
# Valkey memory cap (shared by every project); least recently used keys go first.
# CACHE_MAXMEMORY=64mb
# Web search (SearXNG). Dev defaults match docker/compose.dev.yml.
SEARXNG_URL=http://localhost:8080
# SEARXNG_SECRET=change-me
# Secrets service master key: 32 random bytes (openssl rand -base64 32). Losing it makes stored
# secrets unreadable. To rotate, put the old one in MYBASE_SECRETS_KEY_OLD for one restart.
# MYBASE_SECRETS_KEY=
# Max upload through the API/dashboard, in bytes (default 1 GiB).
MYBASE_MAX_UPLOAD=1073741824

# Admin auth. Without a password here, the dashboard asks you to create the account on first run
# (only from this machine or the LAN).
# MYBASE_ADMIN_USERNAME=admin
# MYBASE_ADMIN_PASSWORD=
# CLI: `mybase login` saves a token; MYBASE_TOKEN overrides it (CI).
# MYBASE_TOKEN=

# Public access through a Cloudflare Tunnel (see docker/compose.yml).
# MYBASE_TRUST_PROXY=cloudflare
# Postgres over WebSocket for serverless apps. Defaults to <MYBASE_PUBLIC_URL>/db.
# MYBASE_DB_WS_URL=
