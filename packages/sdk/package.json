{
  "name": "@mybase-dev/sdk",
  "version": "1.0.5",
  "description": "Client helpers for apps running on mybase: analytics, cron calls, one-off tasks, cache, rate limits, queues, web search, secrets, vector and full-text search, Better Auth, captcha.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandonHarter/mybase.git",
    "directory": "packages/sdk"
  },
  "exports": {
    "./analytics": {
      "bun": "./src/analytics.ts",
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    },
    "./cron": {
      "bun": "./src/cron.ts",
      "types": "./dist/cron.d.ts",
      "default": "./dist/cron.js"
    },
    "./config": {
      "bun": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./cache": {
      "bun": "./src/cache.ts",
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./ratelimit": {
      "bun": "./src/ratelimit.ts",
      "types": "./dist/ratelimit.d.ts",
      "default": "./dist/ratelimit.js"
    },
    "./queue": {
      "bun": "./src/queue.ts",
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./search": {
      "bun": "./src/search.ts",
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./secrets": {
      "bun": "./src/secrets.ts",
      "types": "./dist/secrets.d.ts",
      "default": "./dist/secrets.js"
    },
    "./vector": {
      "bun": "./src/vector.ts",
      "types": "./dist/vector.d.ts",
      "default": "./dist/vector.js"
    },
    "./better-auth": {
      "bun": "./src/better-auth.ts",
      "types": "./dist/better-auth.d.ts",
      "default": "./dist/better-auth.js"
    },
    "./captcha": {
      "bun": "./src/captcha.ts",
      "types": "./dist/captcha.d.ts",
      "default": "./dist/captcha.js"
    }
  },
  "files": [
    "dist",
    "src/analytics.ts",
    "src/cron.ts",
    "src/config.ts",
    "src/cache.ts",
    "src/ratelimit.ts",
    "src/queue.ts",
    "src/search.ts",
    "src/secrets.ts",
    "src/vector.ts",
    "src/better-auth.ts",
    "src/captcha.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/analytics.ts src/cron.ts src/config.ts src/cache.ts src/ratelimit.ts src/queue.ts src/search.ts src/secrets.ts src/vector.ts src/better-auth.ts src/captcha.ts --root src --outdir dist --target node --format esm && bun build src/analytics-script.ts --outfile dist/analytics.min.js --target browser --format iife --minify && bun build src/captcha-widget.ts --outfile dist/captcha.min.js --target browser --format iife --minify && tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "license": "MIT",
  "homepage": "https://github.com/LandonHarter/mybase#readme"
}
