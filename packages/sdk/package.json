{
  "name": "@mybase/sdk",
  "version": "0.4.0",
  "description": "Client helpers for apps running on mybase: analytics, cron calls, one-off tasks, cache, rate limits.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landonharter/mybase.git",
    "directory": "packages/sdk"
  },
  "exports": {
    "./analytics": {
      "bun": "./src/analytics.ts",
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    },
    "./cron": {
      "bun": "./src/cron.ts",
      "types": "./dist/cron.d.ts",
      "default": "./dist/cron.js"
    },
    "./config": {
      "bun": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./cache": {
      "bun": "./src/cache.ts",
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./ratelimit": {
      "bun": "./src/ratelimit.ts",
      "types": "./dist/ratelimit.d.ts",
      "default": "./dist/ratelimit.js"
    }
  },
  "files": [
    "dist",
    "src/analytics.ts",
    "src/cron.ts",
    "src/config.ts",
    "src/cache.ts",
    "src/ratelimit.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/analytics.ts src/cron.ts src/config.ts src/cache.ts src/ratelimit.ts --outdir dist --target node --format esm && bun build src/analytics-script.ts --outfile dist/analytics.min.js --target browser --format iife --minify && tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  }
}
