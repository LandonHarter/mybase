{
  "name": "@mybase/cli",
  "version": "1.0.0",
  "description": "The mybase CLI: projects, keys, cron, queues, cache, rate limits, analytics, docs, and agent setup for a self-hosted mybase.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/landonharter/mybase.git",
    "directory": "apps/cli"
  },
  "bin": { "mybase": "./dist/mybase.js" },
  "files": ["dist"],
  "engines": { "bun": ">=1.3" },
  "scripts": {
    "build": "bun build src/index.ts --target bun --outfile dist/mybase.js",
    "compile": "bun build src/index.ts --compile --minify --outfile dist/mybase",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@mybase/sdk": "workspace:*",
    "@mybase/shared": "workspace:*"
  }
}
