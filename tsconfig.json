{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.AsyncIterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "customConditions": ["bun"]
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "scripts"
  ],
  "exclude": [
    "apps/dashboard"
  ]
}
